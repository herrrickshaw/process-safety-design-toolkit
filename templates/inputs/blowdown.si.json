{
  "command": "blowdown",
  "units": "si",
  "_note": "Fill in `inputs` using the unit in each _guide entry. Help text may quote SI units; the `unit` field is the one that applies. psig and psia are different: gauge arguments (set_g, back_g ...) are psig, absolute ones psia. Temperatures are readings, not differences.",
  "inputs": {
    "volume": null,
    "p0": null,
    "T0": null,
    "M": null,
    "k": null,
    "hole_d": null,
    "t_end": 600.0
  },
  "_guide": {
    "volume": {
      "flag": "--volume",
      "required": true,
      "type": "float",
      "unit": "m3",
      "help": "vessel volume, m3",
      "range": {
        "hard_min": 0.0,
        "soft_min": 0.001,
        "soft_max": 500000
      }
    },
    "p0": {
      "flag": "--p0",
      "required": true,
      "type": "float",
      "unit": "kPa abs",
      "help": "initial pressure, kPa abs",
      "range": {
        "hard_min": 0.0,
        "soft_min": 1,
        "soft_max": 100000
      }
    },
    "T0": {
      "flag": "--T0",
      "required": true,
      "type": "float",
      "unit": "K",
      "help": "initial temperature, K",
      "range": {
        "hard_min": 0.0,
        "soft_min": 50,
        "soft_max": 3000
      }
    },
    "M": {
      "flag": "--M",
      "required": true,
      "type": "float",
      "unit": "kg/kmol",
      "help": "molar mass, kg/kmol",
      "range": {
        "hard_min": 0.0,
        "soft_min": 2,
        "soft_max": 500
      }
    },
    "k": {
      "flag": "--k",
      "required": true,
      "type": "float",
      "unit": "-",
      "help": "Cp/Cv",
      "range": {
        "hard_min": 1.0,
        "soft_max": 1.67
      }
    },
    "hole_d": {
      "flag": "--hole-d",
      "required": true,
      "type": "float",
      "unit": "m",
      "help": "hole diameter, m (not mm)",
      "range": {
        "hard_min": 0.0,
        "soft_max": 2000
      }
    },
    "t_end": {
      "flag": "--t-end",
      "required": false,
      "type": "float",
      "unit": "s",
      "help": "end time, s",
      "range": {
        "hard_min": 0.0,
        "soft_max": 86400
      }
    }
  }
}
