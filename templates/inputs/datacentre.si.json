{
  "command": "datacentre",
  "units": "si",
  "_note": "Fill in `inputs` using the unit in each _guide entry. Help text may quote SI units; the `unit` field is the one that applies. psig and psia are different: gauge arguments (set_g, back_g ...) are psig, absolute ones psia. Temperatures are readings, not differences.",
  "inputs": {
    "it_kw": null,
    "facility_kw": null,
    "delta_t": null,
    "heat_kw": null,
    "autonomy_min": null,
    "battery_eff": 0.95,
    "battery_dod": 0.8,
    "gen_hours": null,
    "gen_load_kw": null,
    "sfc": null
  },
  "_guide": {
    "it_kw": {
      "flag": "--it-kw",
      "required": true,
      "type": "float",
      "unit": "kW",
      "help": "",
      "range": {
        "hard_min": 0.0,
        "soft_max": 10000000
      }
    },
    "facility_kw": {
      "flag": "--facility-kw",
      "required": false,
